<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- MS Store 빌드 여부 토글 스위치 -->
    <IsStoreBuild>false</IsStoreBuild>

    <!-- [수정 1] 일반 빌드 시에는 Windows OS 버전을 떼어내어 WinRT SDK 자동 포함을 방지 -->
    <TargetFramework Condition="'$(IsStoreBuild)' != 'true'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(IsStoreBuild)' == 'true'">net10.0-windows10.0.19041.0</TargetFramework>
    
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    
    <!-- UI 자동화 API(System.Windows.Automation)를 사용 -->
    <UseWpf>true</UseWpf>
    
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>images\IMEPali.ico</ApplicationIcon>
    
    <!-- 배포 설정 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    
    <!-- 어셈블리 설정 -->
    <AssemblyName>IMEPali</AssemblyName>
    <RootNamespace>IMEPali</RootNamespace>
    <NoWarn>$(NoWarn);CA1420</NoWarn>

    <!-- Microsoft Store MSIX 패키징 설정 -->
    <EnableMsixTooling Condition="'$(IsStoreBuild)' == 'true'">true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild Condition="'$(IsStoreBuild)' == 'true'">false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled Condition="'$(IsStoreBuild)' == 'true'">true</AppxPackageSigningEnabled>
    
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <InformationalVersion>1.0.2.0</InformationalVersion>
    <Company>stonkim93</Company>
    <Product>IMEPali</Product>
    <Description>Pali and Sanskrit Input Method Editor for Windows</Description>
    <Copyright>Copyright (c) 2024 stonkim93</Copyright>
  </PropertyGroup>

  <!-- 앱 내부 리소스 -->
  <ItemGroup>
    <EmbeddedResource Include="images\IMEPali.ico" />
    <EmbeddedResource Include="images\PaliKey1.png" />
    <EmbeddedResource Include="images\PaliKey2.png" />
  </ItemGroup>

  <!-- MS Store 필수 파일들 -->
  <ItemGroup Condition="'$(IsStoreBuild)' == 'true'">
    <AppxManifest Include="Package.appxmanifest" />
    <Content Include="images\Square44x44Logo.png" />
    <Content Include="images\Square150x150Logo.png" />
    <Content Include="images\StoreLogo.png" />
    <Content Include="images\SplashScreen.png" />
  </ItemGroup>

  <!-- SDK 참조 -->
  <ItemGroup Condition="'$(IsStoreBuild)' == 'true'">
    <FrameworkReference Include="Microsoft.Windows.SDK.NET.Ref" />
  </ItemGroup>

</Project>